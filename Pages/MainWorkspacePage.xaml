<Page x:Class="ToDo.Pages.MainWorkspacePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="MainWorkspacePage"
      Background="{DynamicResource MaterialDesign.Brush.Background}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                Background="{DynamicResource MaterialDesign.Brush.Surface}" 
                BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}" 
                BorderThickness="0,0,1,0">
            <Grid Margin="15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <materialDesign:PackIcon Kind="PlaylistCheck" Width="32" Height="32" 
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" 
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="ToDo" FontSize="22" FontWeight="Bold" 
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="NavigationMenu" 
                         Style="{StaticResource MaterialDesignNavigationListBox}"
                         SelectionChanged="NavigationMenu_SelectionChanged">

                    <ListBoxItem IsSelected="True" x:Name="MenuTasks" Height="50">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListCheckbox" Width="24" Height="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Мои Задачи" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuHabits" Height="50">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HeartPulse" Width="24" Height="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Трекер привычек" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuAI" Height="50">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Brain" Width="24" Height="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ИИ Ассистент" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem x:Name="MenuAnalytics" Height="50">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Аналитика" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <Button Grid.Row="2" Style="{StaticResource MaterialDesignFlatButton}" 
                        Content="Выйти из профиля" Foreground="{DynamicResource MaterialDesign.Brush.Error}"
                        Click="LogoutBtn_Click" HorizontalAlignment="Left" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Surface}" 
                    BorderBrush="{DynamicResource MaterialDesign.Brush.OutlineVariant}" 
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Мои Задачи" 
                               FontSize="20" FontWeight="SemiBold" 
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Name="UserName" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Medium"/>
                        <materialDesign:PackIcon Kind="AccountCircle" Width="32" Height="32" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Frame Grid.Row="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Page>