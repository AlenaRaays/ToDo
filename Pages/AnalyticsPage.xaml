<Page x:Class="ToDo.Pages.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="AnalyticsPage" Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,20">
            <materialDesign:Card Margin="5" Padding="20" UniformCornerRadius="10" Background="#E3F2FD">
                <StackPanel>
                    <TextBlock Text="Всего задач в БД" FontSize="14" Foreground="#1E88E5"/>
                    <TextBlock x:Name="TotalTasksTxt" Text="0" FontSize="36" FontWeight="Bold" Foreground="#1E88E5" Margin="0,10,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="5" Padding="20" UniformCornerRadius="10" Background="#E8F5E9">
                <StackPanel>
                    <TextBlock Text="Привычек в трекере" FontSize="14" Foreground="#43A047"/>
                    <TextBlock x:Name="TotalHabitsTxt" Text="0" FontSize="36" FontWeight="Bold" Foreground="#43A047" Margin="0,10,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="5" Padding="20" UniformCornerRadius="10" Background="#FFF3E0">
                <StackPanel>
                    <TextBlock Text="Запросов к ИИ" FontSize="14" Foreground="#FB8C00"/>
                    <TextBlock x:Name="TotalAiRequestsTxt" Text="0" FontSize="36" FontWeight="Bold" Foreground="#FB8C00" Margin="0,10,0,0"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <materialDesign:Card Grid.Row="1" UniformCornerRadius="10" Padding="20">
            <StackPanel Margin="20">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Ваш прогресс по задачам" 
                   FontSize="18" FontWeight="Bold" 
                   VerticalAlignment="Center" 
                   Grid.Column="0"/>

                    <Button Click="Refresh_Click" 
                Style="{StaticResource MaterialDesignIconButton}" 
                ToolTip="Обновить данные"
                Grid.Column="1">
                        <materialDesign:PackIcon Kind="Refresh"/>
                    </Button>
                </Grid>

                <ProgressBar x:Name="TasksProgressBar" 
                 Height="20" 
                 Minimum="0" Maximum="100" 
                 Foreground="Green"/>

                <TextBlock x:Name="ProgressText" 
               Text="Выполнено: 0 из 0" 
               HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Page>