<Page x:Class="ToDo.Pages.Authorize"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Authorize"
      Background="Transparent">

    <materialDesign:Card UniformCornerRadius="15" 
                         Margin="30" 
                         VerticalAlignment="Center" 
                         materialDesign:ElevationAssist.Elevation="Dp3">
        <StackPanel Margin="25">

            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
                <materialDesign:PackIcon Kind="PlaylistCheck" Width="48" Height="48" 
                                         HorizontalAlignment="Center" 
                                         Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                <TextBlock Text="ToDo" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
            </StackPanel>

            <TextBlock Text="Вход в систему" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBox x:Name="LoginTxt"
                     materialDesign:HintAssist.Hint="Логин"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Margin="0,0,0,15" FontSize="16"/>

            <PasswordBox x:Name="PasswordTxt"
                         materialDesign:HintAssist.Hint="Пароль"
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                         Margin="0,0,0,25" FontSize="16"/>

            <Button x:Name="LoginBtn" 
                    Content="ВОЙТИ" 
                    Click="LoginBtn_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Height="45" 
                    materialDesign:ButtonAssist.CornerRadius="8" 
                    Margin="0,0,0,15"/>

            <Button Content="Еще нет аккаунта? Зарегистрироваться" 
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Click="GoToRegister_Click" 
                    FontSize="12"/>
        </StackPanel>
    </materialDesign:Card>
</Page>