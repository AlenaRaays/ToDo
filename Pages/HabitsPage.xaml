<Page x:Class="ToDo.Pages.HabitsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="HabitsPage" Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" UniformCornerRadius="10" Padding="15" Margin="0,0,0,15" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="NewHabitTxt" materialDesign:HintAssist.Hint="Какую привычку внедряем? (напр., Пить воду)" Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="16" Margin="0,0,15,0"/>
                <Button Grid.Column="1" Click="AddHabitBtn_Click" Style="{StaticResource MaterialDesignRaisedButton}" Width="130" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HeartPlus" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Создать" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <ListBox Grid.Row="1" x:Name="HabitsListBox" 
         HorizontalContentAlignment="Stretch" 
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <materialDesign:Card UniformCornerRadius="8" Margin="0,4" Padding="15" 
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Fire" Foreground="Orange" Width="16" Height="16"/>
                                    <TextBlock Text="{Binding Streak, StringFormat='Стрик: {0} дней'}" 
                                       Foreground="Gray" FontSize="13" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" Click="CompleteHabitBtn_Click" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Content="Засчитать день" Margin="0,0,10,0"/>

                            <Button Grid.Column="2" Click="DeleteHabitBtn_Click" 
                            Style="{StaticResource MaterialDesignFlatButton}" 
                            Foreground="{DynamicResource MaterialDesign.Brush.Error}">
                                <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                    </materialDesign:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>